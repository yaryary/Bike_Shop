#for adding repairs into the system
def add_repair(conn, bike_ID, description, parts_cost, labor_cost, notes):
    curs = conn.cursor()
    query = """
    INSERT into bikerepairs
    (bike_ID, repair_status, repair_description, ticket_creation, parts_cost, labor_cost, notes)
    values(%s, 'Pending', %s, curdate(), %s, %s, %s)
    """
    curs.execute(query,(bike_ID, description, parts_cost, labor_cost, notes))
    conn.commit()

#looks for repairs that are ongoing
def ongoing_repairs(conn):
    curs = conn.cursor(dictionary=True)
    query = """
    SELECT bike_repair_ID, bike_ID, repair_description
    FROM BikeRepairs
    WHERE ticket_completed IS NULL
    """
    curs.execute(query)
    return curs.fetchall()

#it marks repairs as complete
def mark_repair_completed(conn, repair_id):
    curs = conn.cursor()
    query = """
    UPDATE BikeRepairs
    SET ticket_completed = CURDATE()
    WHERE bike_repair_ID = %s
    """
    curs.execute(query,(repair_id))
    conn.commit()

#deletes repairs using their id
def delete_repair(conn, repair_id):
    curs = conn.cursor()
    query = "DELETE FROM bikerepairs WHERE bike_repair_ID = %s"
    curs.execute(query, (repair_id,))
    conn.commit()

#checks for bikes with prices higher than 450
def bikes_over_450(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute("""
    SELECT bike_id, bike_model, bike_brand, bike_price
    FROM Bike
    WHERE bike_price > 450
    """)
    return curs.fetchall()


#shows bikes by their current status
def bikes_by_status(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute("""
    SELECT bike_status, COUNT(*) AS total_bikes
    FROM Bike
    GROUP BY bike_status
    """)
    return curs.fetchall()

#sorts bikes by type and stock status
def bikes_by_price_desc(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute("""
    SELECT bike_id, bike_type, bike_model, bike_price
    FROM Bike
    ORDER BY bike_price DESC
    """)
    return curs.fetchall()


#Find users with active accounts
def get_user_order_spending_summary(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute("""
    SELECT
        u.user_ID,
        u.first_name,
        u.last_name,
        u.email_address,
        u.user_role,
        u.is_active,
        COUNT(s.sale_ID) AS total_orders,
        SUM(s.sale_amount) AS total_spent
    FROM User u
    LEFT JOIN Sales s
        ON s.costumer_ID = u.user_ID
    GROUP BY
        u.user_ID, u.first_name, u.last_name,
        u.email_address, u.user_role, u.is_active
    ORDER BY total_spent DESC
    """)
    return curs.fetchall()


def create_sales_no_negative_amount_trigger(conn):
    curs = conn.cursor()
    curs.execute("DROP TRIGGER IF EXISTS trg_sales_no_negative_amount")
    curs.execute("""
    CREATE TRIGGER trg_sales_no_negative_amount
    BEFORE INSERT ON Sales
    FOR EACH ROW
    BEGIN
        IF NEW.sale_amount < 0 THEN
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'sale_amount cannot be negative';
        END IF;
    END
    """)
    conn.commit()


