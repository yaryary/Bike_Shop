#view all repairs
def view_all_repairs(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute( """
    SELECT bike_repair_ID, bike_ID, repair_status, repair_description,
           ticket_creation, ticket_completed, parts_cost, labor_cost, notes
    FROM bikerepairs
    """
    )
    return curs.fetchall()
#repairs per bike
def repairs_per_bike(conn):
    curs = conn.cursor(dictionary=True)
    curs.execute( """
    SELECT bike_ID, COUNT(bike_repair_ID) AS total_repairs
    FROM bikerepairs
    GROUP BY bike_ID
    """
    )
    return curs.fetchall()

#looks at all completed repairs
def view_completed_repairs(conn):
    curs = conn.cursor(dictionary=True)
